{
  "name": "nodara-showcase",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/gftsantos/nodara",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run build:lib && npm run build:site",
    "build:lib": "npm run build -w @nodara/core && npm run build -w @nodara/react && npm run build -w @nodara/vue && npm run build -w @nodara/angular && npm run build -w @nodara/web-components",
    "build:site": "node scripts/package-downloads.mjs && vinext build",
    "start": "vinext start",
    "test": "npm run test:lib && npm run build:site && node --test tests/rendered-html.test.mjs",
    "test:lib": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build:lib && playwright test",
    "test:all": "npm run verify:release",
    "typecheck": "npm run build:lib && npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.portal.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run verify:release && changeset publish",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:contracts": "vitest run --config vitest.audit.config.ts",
    "test:audit": "playwright test --config=playwright.audit.config.ts",
    "test:consumers": "node scripts/build-audit-consumers.mjs && playwright test --config=playwright.runtime-audit.config.ts",
    "security:check": "node scripts/security-gate.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "benchmark": "node scripts/benchmark-beta.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@angular/compiler": "^21.2.21",
    "@angular/compiler-cli": "^21.2.21",
    "@angular/core": "^21.0.0",
    "@changesets/cli": "^2.29.7",
    "@cloudflare/vite-plugin": "1.62.3",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-sankey": "0.12.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "axe-core": "4.11.4",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "happy-dom": "^20.11.6",
    "react-server-dom-webpack": "19.2.8",
    "semver": "7.8.5",
    "tailwindcss": "4.2.1",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.0.16",
    "vitest": "4.1.11",
    "vue": "^3.5.21",
    "wrangler": "4.145.0",
    "zone.js": "^0.15.1"
  },
  "type": "module",
  "packageManager": "npm@11.19.1"
}
