{
  "name": "@nodara/core",
  "version": "0.1.0-alpha.1",
  "description": "Framework-agnostic visual engine for Gantt, charts, topologies and calendars.",
  "license": "MIT",
  "homepage": "https://nodara-visual.gftsantos.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/gftsantos/nodara.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gftsantos/nodara/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css",
    "./working-time": {
      "import": { "types": "./dist/working-time.d.ts", "default": "./dist/working-time.js" },
      "require": { "types": "./dist/working-time.d.cts", "default": "./dist/working-time.cjs" }
    }
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/working-time.ts --format esm,cjs --dts --clean --sourcemap --treeshake",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gantt",
    "charts",
    "graph",
    "topology",
    "calendar",
    "typescript",
    "visualization"
  ],
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "d3-hierarchy": "3.1.2",
    "d3-sankey": "0.12.3"
  }
}
