{
  "name": "@nodara/angular",
  "version": "0.1.0-alpha.1",
  "description": "Official Angular standalone components for Nodara.",
  "license": "MIT",
  "homepage": "https://nodara-visual.gftsantos.chatgpt.site",
  "repository": { "type": "git", "url": "https://github.com/gftsantos/nodara.git", "directory": "packages/angular" },
  "bugs": { "url": "https://github.com/gftsantos/nodara/issues" },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "ngc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": { "@nodara/core": "0.1.0-alpha.1" },
  "peerDependencies": { "@angular/core": ">=21.2.21 <22" },
  "publishConfig": { "access": "public" }
}
