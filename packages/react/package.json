{
  "name": "@nodara/react",
  "version": "0.1.0-beta.1",
  "description": "Official React bindings for Nodara visual components.",
  "license": "MIT",
  "homepage": "https://nodara-visual.gftsantos.chatgpt.site",
  "repository": { "type": "git", "url": "https://github.com/gftsantos/nodara.git", "directory": "packages/react" },
  "bugs": { "url": "https://github.com/gftsantos/nodara/issues" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --sourcemap --treeshake --external react --external @nodara/core",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": { "@nodara/core": "0.1.0-beta.1" },
  "peerDependencies": { "react": ">=18.2.0" },
  "publishConfig": { "access": "public" }
}
