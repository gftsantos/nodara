{
  "name": "@nodara/vue",
  "version": "0.1.0-alpha.1",
  "description": "Official Vue bindings for Nodara visual components.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --treeshake --external vue --external @nodara/core",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": { "@nodara/core": "0.1.0-alpha.1" },
  "peerDependencies": { "vue": ">=3.3.0" },
  "publishConfig": { "access": "public" }
}
